---
interface Line {
  speaker: 'leader' | 'all';
  text: string;
}

interface Props {
  title?: string;
  lines: Line[];
  compact?: boolean;
}

const { title, lines, compact = false } = Astro.props;
const isDialogue = lines.length > 1;
---

<div class:list={['prayer', { 'prayer--compact': compact }]}>
  {title && <h3 class="prayer__title">{title}</h3>}
  <div class="prayer__lines">
    {
      lines.map((line) =>
        isDialogue ? (
          <p class:list={['prayer__line', `prayer__line--${line.speaker}`]}>{line.text}</p>
        ) : (
          <p class="prayer__line prayer__line--solo">{line.text}</p>
        )
      )
    }
  </div>
</div>

<style>
  .prayer__title {
    font-family: var(--font-read);
    font-weight: 500;
    font-size: var(--text-h4);
    color: var(--teal);
    margin-bottom: var(--space-4);
  }

  .prayer__lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 62ch;
  }

  .prayer__line {
    margin: 0;
    font-family: var(--font-read);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.6vw, 1.35rem);
    line-height: 1.6;
  }

  .prayer--compact .prayer__line {
    font-size: var(--text-body);
  }

  .prayer__line--leader,
  .prayer__line--solo {
    color: var(--text);
  }

  /* The answer: indented on a soft seafoam rule, with a small "All" above
     it, so whoever is reading aloud knows where everyone joins in. */
  .prayer__line--all {
    color: var(--ink-strong);
    font-weight: 600;
    padding-left: var(--space-5);
    border-left: 3px solid var(--seafoam);
  }
  .prayer__line--all::before {
    content: 'All';
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-micro);
    color: var(--coral-text);
    margin-bottom: 0.1rem;
  }
</style>
