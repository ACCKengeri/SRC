---
// A styled native <details>/<summary> disclosure — keyboard-accessible and
// screen-reader-correct with zero JS, and it works with JS disabled. Grouped
// into an accordion via the shared `name` (one open at a time) where a page
// passes the same `group` to each.
interface Props {
  heading: string;
  sub?: string;
  group?: string;
  open?: boolean;
}
const { heading, sub, group, open = false } = Astro.props;
---

<details class="disc p-grain" name={group} open={open}>
  <summary class="disc__summary">
    <span class="disc__head">
      <span class="disc__name">{heading}</span>
      {sub && <span class="disc__sub">{sub}</span>}
    </span>
    <span class="disc__icon" aria-hidden="true"></span>
  </summary>
  <div class="disc__body">
    <slot />
  </div>
</details>

<style>
  /* A stack of paper folders: each disclosure is a folder in its own paper
     colour with a tab on top, laid a little over the one before it. The open
     folder shows its contents; the tab and summary stay the hit target. */
  .disc {
    --pc: var(--sheet);
    position: relative;
    margin-top: 22px;
    background-color: var(--pc);
    border-radius: 0 var(--radius-sm) var(--radius-sm) var(--radius-sm);
    box-shadow: var(--lift-1);
  }
  .disc + .disc {
    margin-top: 14px;
  }
  .disc::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 100%;
    width: clamp(7rem, 22%, 11rem);
    height: 16px;
    background: inherit;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    clip-path: polygon(0 0, 86% 0, 100% 100%, 0 100%);
  }
  .disc:nth-of-type(6n + 1) { --pc: var(--seafoam); }
  .disc:nth-of-type(6n + 2) { --pc: var(--butter); }
  .disc:nth-of-type(6n + 3) { --pc: var(--sky); }
  .disc:nth-of-type(6n + 4) { --pc: var(--peach); }
  .disc:nth-of-type(6n + 5) { --pc: var(--sheet); }
  .disc:nth-of-type(6n + 6) { --pc: var(--coral-wash); }
  .disc[open] {
    box-shadow: var(--lift-2);
  }

  .disc__summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-5) clamp(1.25rem, 3vw, 2rem);
    min-height: 44px;
  }
  .disc__summary::-webkit-details-marker {
    display: none;
  }
  .disc__summary:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--teal-deep);
    border-radius: var(--radius-sm);
  }

  .disc__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    flex-wrap: wrap;
  }
  .disc__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h4);
    letter-spacing: -0.015em;
    color: var(--ink-strong);
  }
  .disc__sub {
    color: var(--ink);
    font-size: var(--text-small);
  }

  /* the plus is a small paper disc */
  .disc__icon {
    position: relative;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--sheet);
    box-shadow: 0 1px 2px rgba(11, 63, 67, 0.25);
  }
  .disc__icon::before,
  .disc__icon::after {
    content: '';
    position: absolute;
    background: var(--teal-deep);
    inset: 0;
    margin: auto;
    border-radius: 1px;
  }
  .disc__icon::before {
    width: 12px;
    height: 2px;
  }
  .disc__icon::after {
    width: 2px;
    height: 12px;
    transition: transform var(--duration-medium) var(--ease-soft);
  }
  .disc[open] .disc__icon::after {
    transform: scaleY(0);
  }

  .disc__body {
    margin: 0 clamp(0.5rem, 1.5vw, 1rem) clamp(0.5rem, 1.5vw, 1rem);
    padding: var(--space-6) clamp(1rem, 3vw, 2rem);
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--sheet) 82%, transparent);
    color: var(--ink);
  }
</style>
