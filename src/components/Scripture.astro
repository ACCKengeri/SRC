---
import { scripture, type ScriptureId, type Verse } from '../lib/scripture';

interface Props {
  /** Look the verse up from src/lib/scripture.ts … */
  id?: ScriptureId;
  /** … or pass it directly. */
  verse?: Verse;
  /**
   * feature: a papercut frame, the page's dividing moment.
   * quiet:   an inset pull-quote inside body content.
   */
  variant?: 'feature' | 'quiet';
}

const { id, verse, variant = 'feature' } = Astro.props;
const v: Verse = verse ?? (id ? scripture[id] : (() => { throw new Error('Scripture needs an id or a verse'); })());

/*
  The feature is a papercut frame: four sheets of paper stacked inside each
  other, each cut with its own edge (a slow wave, then scallops, then a plain
  cut), lifted off the one beneath by a soft shadow, with the verse on sky
  paper at the centre. The cut edges are SVG masks, built here once.
*/
const VW = 1000, VH = 600;
const outline = (inset: number, bumps: number, amp: number, kind: 'wave' | 'scallop') => {
  const x0 = inset, y0 = inset, x1 = VW - inset, y1 = VH - inset;
  const per = 2 * (x1 - x0 + (y1 - y0));
  const pts: string[] = [];
  const n = 480;
  for (let k = 0; k < n; k++) {
    const s = (k / n) * per;
    let x: number, y: number, nx: number, ny: number;
    const w = x1 - x0, h = y1 - y0;
    if (s < w) [x, y, nx, ny] = [x0 + s, y0, 0, 1];
    else if (s < w + h) [x, y, nx, ny] = [x1, y0 + (s - w), -1, 0];
    else if (s < 2 * w + h) [x, y, nx, ny] = [x1 - (s - w - h), y1, 0, -1];
    else [x, y, nx, ny] = [x0, y1 - (s - 2 * w - h), 1, 0];
    const t = (s / per) * bumps;
    const off = kind === 'wave' ? amp * (0.5 + 0.5 * Math.sin(t * Math.PI * 2)) : amp * (1 - Math.abs(Math.sin(t * Math.PI)));
    pts.push(`${(x + nx * off).toFixed(1)},${(y + ny * off).toFixed(1)}`);
  }
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${VW} ${VH}' preserveAspectRatio='none'><polygon points='${pts.join(' ')}'/></svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg).replace(/'/g, '%27')}")`;
};
const waveMask = outline(1, 34, 14, 'wave');
const scallopMask = outline(1, 52, 12, 'scallop');
---

{
  variant === 'feature' ? (
    <section class="scripture">
      <figure class="sbox p-grain reveal-lay" style={`--wave:${waveMask};--scallop:${scallopMask};--lay-r:0.8deg`}>
        <div class="sbox__sh">
          <div class="sbox__l sbox__l2 p-grain">
            <div class="sbox__sh">
              <div class="sbox__l sbox__l3 p-grain">
                <div class="sbox__sh">
                  <div class="sbox__l sbox__l4 p-grain">
                    <div class="sbox__back p-grain">
                      <blockquote class="scripture__verse">{v.text}</blockquote>
                      <figcaption class="scripture__ref">
                        {v.reference}, <span class="scripture__tr">{v.translation}</span>
                      </figcaption>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </figure>
    </section>
  ) : (
    <figure class="scripture-quiet">
      <blockquote class="scripture-quiet__verse">{v.text}</blockquote>
      <figcaption class="scripture-quiet__ref">
        {v.reference}, {v.translation}
      </figcaption>
    </figure>
  )
}

<style>
  /* ---- feature: the papercut frame ---- */
  .scripture {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .sbox {
    margin: 0;
    padding: clamp(14px, 2.4vw, 28px);
    border-radius: var(--radius-lg);
    background-color: var(--teal-band);
    box-shadow: var(--lift-2);
  }
  /* The shadow sits on a wrapper: a filter on the masked sheet itself would be cut away by its own mask. */
  .sbox__sh {
    filter: drop-shadow(0 2px 2px rgba(6, 33, 36, 0.22)) drop-shadow(0 8px 10px rgba(6, 33, 36, 0.16));
  }
  .sbox__l {
    padding: clamp(12px, 2.2vw, 26px);
  }
  .sbox__l2 {
    background-color: var(--seafoam);
    -webkit-mask: var(--wave) 0 0 / 100% 100% no-repeat;
    mask: var(--wave) 0 0 / 100% 100% no-repeat;
  }
  .sbox__l3 {
    background-color: var(--butter);
    -webkit-mask: var(--scallop) 0 0 / 100% 100% no-repeat;
    mask: var(--scallop) 0 0 / 100% 100% no-repeat;
  }
  .sbox__l4 {
    background-color: var(--sheet);
    border-radius: var(--radius-sm);
  }
  .sbox__back {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background-color: var(--sky);
    box-shadow: inset 0 3px 6px rgba(6, 33, 36, 0.18);
    padding: clamp(2.75rem, 7vw, 5.5rem) clamp(1.25rem, 5vw, 4rem);
    text-align: center;
  }
  /* a faint sunburst cut into the sky behind the verse */
  .sbox__back::before {
    content: '';
    position: absolute;
    inset: -60%;
    background: repeating-conic-gradient(from 0deg at 50% 50%, rgba(255, 255, 255, 0.28) 0deg 6deg, transparent 6deg 20deg);
    pointer-events: none;
  }
  .scripture__verse,
  .scripture__ref {
    position: relative;
  }
  .scripture__verse {
    max-width: 22ch;
    margin: 0 auto;
    font-family: var(--font-read);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    line-height: 1.18;
    color: var(--ink-strong);
    text-wrap: balance;
    quotes: '\201C' '\201D';
  }
  .scripture__verse::before {
    content: open-quote;
  }
  .scripture__verse::after {
    content: close-quote;
  }
  .scripture__ref {
    display: block;
    margin-top: var(--space-5);
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .scripture__tr {
    letter-spacing: 0.08em;
    font-size: var(--text-micro);
  }

  /* ---- quiet: inset pull-quote in body content ---- */
  .scripture-quiet {
    margin: 0;
    padding-left: var(--space-5);
    border-left: 3px solid var(--mark);
    max-width: 40ch;
  }
  .scripture-quiet__verse {
    margin: 0;
    font-family: var(--font-read);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.4;
    color: var(--teal);
    quotes: '\201C' '\201D';
  }
  .scripture-quiet__verse::before {
    content: open-quote;
  }
  .scripture-quiet__verse::after {
    content: close-quote;
  }
  .scripture-quiet__ref {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }
</style>
