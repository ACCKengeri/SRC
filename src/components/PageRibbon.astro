---
/*
  The page ribbon's host: an empty layer behind the content, as tall as the
  page, that src/scripts/ribbon/page.ts fills with the satin ribbon. It sits
  under every in-flow block (z-index -1 in the root stacking context, over the
  body's ground), so any panel with its own background hides it. Decorative:
  hidden from assistive tech, no pointer events. No JavaScript: no ribbon.
*/
---

<div class="page-ribbon" aria-hidden="true"></div>

<script>
  import { initPageRibbon } from '../scripts/ribbon/page';
  const host = document.querySelector<HTMLElement>('.page-ribbon');
  if (host) initPageRibbon(host);
</script>

<style>
  .page-ribbon {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .page-ribbon :global(canvas) {
    position: absolute;
    left: 0;
    width: 100%;
    display: block;
  }
</style>
