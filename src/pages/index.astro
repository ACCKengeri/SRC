---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import Scripture from '../components/Scripture.astro';
import InstagramGrid from '../components/InstagramGrid.astro';
import PaperEdge from '../components/PaperEdge.astro';
import HomeLinks from '../components/HomeLinks.astro';
import { domainBanners } from '../lib/domain-images';
import community from '../assets/images/media/bereshith/03.jpg';

const base = import.meta.env.BASE_URL;
const domains = (await getCollection('domains')).sort((a, b) => a.data.order - b.data.order);
// Each domain's card is cut from its own paper.
const PAPERS = ['p-peach', 'p-butter', 'p-seafoam', 'p-sky', 'p-coral', 'p-sheet'];
---

<BaseLayout
  title="Association of Christian Christites"
  description="The Christian student community at CHRIST (Deemed to be University), Kengeri campus, Bengaluru."
>
  <HeroScene />

  <PaperEdge layers={['var(--sky)', 'var(--seafoam)', 'var(--paper)']} seed={3} class="home-edge" />

  <div class="notice-wrap ticket-shadow reveal" id="notice">
    <aside class="notice ticket p-grain" aria-label="Notice">
      <p class="notice__what" data-live-text="notice_title">Rosary, every evening</p>
      <p class="notice__when" data-live-text="notice_when">7:00 pm, St. Kuriakose Elias Chapel</p>
      <a class="notice__go perf" href={`${base}prayers/#rosary`} data-live-href="notice_link" data-live-text="notice_link_label">Pray along</a>
    </aside>
  </div>

  <section class="intro" aria-labelledby="intro-heading">
    <div class="intro__text reveal">
      <h2 id="intro-heading" class="intro__h">
        Over <span class="cut-num">5,000</span> Christian students, one community.
      </h2>
      <p class="intro__copy">
        The Association of Christian Christites (ACC) is a thriving community at Christ (Deemed to
        Be University). We aim to spread the good news, fostering fellowship and a positive campus
        environment.
      </p>
      <a class="btn--link" href={`${base}about/`}>Our story and team</a>
    </div>
    <div class="intro__media print print--seafoam reveal-lay" style="--lay-r:-2.4deg;--rest-r:-1deg">
      <Image
        src={community}
        alt="ACC members together on stage at the Bereshith orientation"
        widths={[560, 900, 1200]} width={1200}
        sizes="(max-width: 56rem) 100vw, 48vw"
      />
    </div>
  </section>

  <Scripture id="servant" variant="feature" />

  <section class="domains" aria-labelledby="domains-heading">
    <div class="domains__head reveal">
      <h2 id="domains-heading">Six domains, one community</h2>
      <p>Every member finds a place through one of six domains, each run by students, for students.</p>
    </div>

    <div class="bento">
      {
        domains.map(({ data }, i) => (
          <a
            class:list={['tile', 'sheet', 'sheet--card', 'reveal-lay', PAPERS[i % PAPERS.length]]}
            style={`--reveal-i:${i % 3};--lay-r:${i % 2 ? -1.4 : 1.4}deg`}
            href={`${base}domains/${data.id}/`}
          >
            <span class="tile__photo">
              <Image
                src={domainBanners[data.id]}
                alt=""
                widths={[420, 720, 1100]} width={1100}
                sizes={i === 0 ? '(max-width: 48rem) 100vw, 50vw' : '(max-width: 48rem) 100vw, 25vw'}
              />
            </span>
            <span class="tile__t">
              <span class="tile__name">{data.name}</span>
              <span class="tile__tag">{data.subtitle}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <HomeLinks />

  <InstagramGrid />
</BaseLayout>

<script>
  // The notice can be switched off from the studio (Settings, "Show the home notice").
  import { onLive } from '../lib/live/read';
  import { setting } from '../lib/live/schema';
  onLive((d) => {
    const n = document.getElementById('notice');
    if (n) n.hidden = /^(no|false|off|hide)$/i.test(setting(d.settings, 'notice_show'));
  });
</script>

<style>
  /* ---- the cut-paper edge where the hero hands over to the page ---- */
  .home-edge {
    margin-top: calc(-1 * clamp(56px, 7vw, 110px));
    position: relative;
    z-index: 1;
  }

  /* ---- Rosary notice: a butter ticket right under the hero ---- */
  .notice-wrap {
    max-width: var(--container-wide);
    margin: var(--space-6) auto 0;
    padding: 0 var(--gutter);
  }
  .notice {
    background-color: var(--butter);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-4) var(--space-7);
  }
  .notice__what {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink-strong);
  }
  .notice__when {
    color: var(--ink);
    font-size: var(--text-small);
  }
  .notice__go {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-left: var(--space-5);
    font-weight: 700;
    font-size: var(--text-small);
    color: var(--ink-strong);
    text-decoration: underline;
    text-decoration-color: var(--coral);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  /* ---- intro: a statement beside a mounted print ---- */
  .intro {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: var(--space-10) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }
  .intro__h {
    font-size: var(--text-h2);
    letter-spacing: -0.03em;
    color: var(--teal);
    max-width: 14ch;
    line-height: 1.1;
  }
  .intro__h .cut-num {
    display: inline-block;
    font-size: 1.3em;
    line-height: 0.95;
  }
  .intro__copy {
    margin-top: var(--space-5);
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--muted);
    max-width: 40ch;
  }
  .intro .btn--link {
    margin-top: var(--space-4);
    display: inline-flex;
    align-items: center;
  }
  .intro__media {
    aspect-ratio: 4 / 3;
    --mat: 10px;
  }

  /* ---- domains: six paper cards, each cut from its own colour ---- */
  .domains {
    max-width: var(--container-wide);
    margin: var(--space-10) auto;
    padding: 0 var(--gutter);
  }
  .domains__head {
    margin-bottom: var(--space-7);
  }
  .domains__head h2 {
    font-size: var(--text-h2);
    letter-spacing: -0.03em;
    color: var(--teal);
  }
  .domains__head p {
    margin-top: var(--space-4);
    color: var(--muted);
    max-width: 52ch;
    font-size: var(--text-lead);
  }

  /* 4 columns: one large (2x2), one wide, two small, two wide. Six cards,
     twelve cells, no gaps. */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(clamp(15rem, 21vw, 18rem), auto);
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .tile:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile:nth-child(2),
  .tile:nth-child(5),
  .tile:nth-child(6) {
    grid-column: span 2;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 10px 10px 0;
    color: var(--ink);
    transition: transform 0.5s var(--ease-soft), box-shadow 0.5s var(--ease-soft), opacity 0.6s var(--ease-soft);
  }
  .tile__photo {
    position: relative;
    flex: 1;
    min-height: 8rem;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background: var(--teal-wash);
    box-shadow: 0 1px 2px rgba(11, 63, 67, 0.18);
  }
  .tile__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-soft);
  }
  .tile.is-in:hover,
  .tile.is-in:focus-visible {
    transform: translateY(-4px) rotate(-0.6deg);
    box-shadow: var(--lift-3);
  }
  .tile:hover :global(img),
  .tile:focus-visible :global(img) {
    transform: scale(1.04);
  }
  .tile.is-in:active {
    transform: translateY(-1px);
  }
  .tile__t {
    display: block;
    padding: var(--space-4) var(--space-3);
  }
  .tile__name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    letter-spacing: -0.015em;
    color: var(--ink-strong);
  }
  .tile:nth-child(1) .tile__name {
    font-size: var(--text-h3);
  }
  .tile__tag {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-small);
    color: var(--ink);
    max-width: 44ch;
  }

  @media (max-width: 56rem) {
    .intro {
      grid-template-columns: 1fr;
      padding: var(--space-9) var(--gutter);
    }
    .intro__media {
      order: -1;
      margin-right: 12px;
    }
    .notice {
      padding: var(--space-4) var(--space-6);
    }
    .notice__go {
      margin-left: 0;
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 48rem) {
    .bento {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .tile:nth-child(n) {
      grid-column: auto;
      grid-row: auto;
    }
    .tile__photo {
      flex: none;
      aspect-ratio: 16 / 10;
    }
  }
</style>
